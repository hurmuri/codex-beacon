<Application
    x:Class="CodexBeacon.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="InkColor">#17202A</Color>
            <Color x:Key="MutedColor">#5D6A78</Color>
            <Color x:Key="SignalColor">#087F5B</Color>
            <Color x:Key="SignalSoftColor">#E5F6EF</Color>
            <Color x:Key="WarningColor">#9A6700</Color>
            <Color x:Key="DangerColor">#B42318</Color>
            <Color x:Key="CanvasColor">#F4F7F9</Color>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="SignalBrush" Color="{StaticResource SignalColor}" />
            <SolidColorBrush x:Key="SignalSoftBrush" Color="{StaticResource SignalSoftColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#D8E0E7" />

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Margin" Value="0,28,0,12" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                <Setter Property="BorderBrush" Value="#E7AAA4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="#FFF8F7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
