                                            <TextBlock Grid.Column="2" x:Uid="TailnetAddressHeader" Text="Tailscale IP" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" x:Uid="TailnetOnlineHeader" Text="状态" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" x:Uid="TailnetLastSeenHeader" Text="最后活跃" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                        </Grid>
