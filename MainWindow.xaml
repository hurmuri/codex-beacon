                                                    <DataTemplate>
                                                        <Grid Padding="12,7" ColumnSpacing="16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="148" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ToggleSwitch HorizontalAlignment="Left" VerticalAlignment="Center" OnContent="" OffContent="" IsOn="{Binding IsVisible, Mode=OneWay}" Toggled="OpenCodexModelVisibility_Toggled" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Id}" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- 计划任务设置 -->
                        <TextBlock x:Uid="ServiceSettingsHeading" Text="服务设置" Style="{StaticResource SectionTitleStyle}" />
