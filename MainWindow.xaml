                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <ComboBox x:Uid="OpenCodexModelPicker" x:Name="OpenCodexModelPicker" MinWidth="360" MaxWidth="520" ItemsSource="{x:Bind VisibleOpenCodexModels}" DisplayMemberPath="DisplayName" PlaceholderText="请选择模型进行测试" />
