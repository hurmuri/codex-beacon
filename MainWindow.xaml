                                    <TextBlock x:Name="NvmLatestVersionText" Text="最新版本 —" Style="{StaticResource MonoCaptionStyle}" />
                                    <TextBlock x:Name="NvmPathText" Text="—" Style="{StaticResource MonoCaptionStyle}" TextWrapping="Wrap" MaxLines="2" />
