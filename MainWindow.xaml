                                    <Button x:Name="OpenCodexInstallButton" x:Uid="ActionInstall" Content="安装" Tag="install" Click="OpenCodexAction_Click" Style="{StaticResource ActionButtonStyle}" />
                                    <Button x:Name="OpenCodexUpgradeButton" x:Uid="ActionUpgrade" Content="升级" Tag="upgrade" Click="OpenCodexAction_Click" Style="{StaticResource ActionButtonStyle}" />
