<Window
    x:Class="CodexBeacon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Codex Beacon">

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource BarBrush}" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
                <FontIcon Glyph="&#xE950;" FontSize="14" Foreground="{StaticResource SignalBrush}" />
                <TextBlock Text="CODEX BEACON" FontSize="12" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{StaticResource InkBrush}" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="UpdateInfoBar" Grid.Row="1" IsOpen="False" Severity="Informational"
                 Margin="20,10,20,0" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateInfoBarActionButton" Style="{StaticResource QuietButtonStyle}" Click="UpdateInfoBarAction_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="True" SelectionChanged="Nav_SelectionChanged"
                        Background="Transparent" OpenPaneLength="212" CompactPaneLength="52">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavDashboard" Content="总览" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="OpenCodex" Tag="opencodex">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDependencies" Content="依赖管理" Tag="installations">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavProcesses" Content="进程" Tag="processes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavNetwork" Content="网络与代理" Tag="network">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavTailscale" Content="Tailscale" Tag="tailscale">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC27;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Codex Relay" Tag="relay">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSettings" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- ============================ 总览 ============================ -->
                <ScrollViewer x:Name="DashboardPage" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,20,28,36">
                    <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                        <TextBlock x:Uid="DashboardTitle" Text="Codex 总览" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Uid="OverallMessage" x:Name="OverallMessageText" Text="正在读取本机 Codex 工具链…"
                                           Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                                <TextBlock x:Name="PulseTimestampText" x:Uid="AwaitingFirstSample" Text="等待首次采样"
                                           Style="{StaticResource MonoCaptionStyle}" VerticalAlignment="Center" />
                                <Button x:Name="RefreshButton" Style="{StaticResource QuietButtonStyle}" Click="Refresh_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        <TextBlock x:Uid="RefreshNow" Text="立即刷新" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="16,12">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="OverviewStoreChannelLabel" Text="Microsoft Store 渠道状态" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="StoreDependencyText" x:Uid="DetectingStatus" Text="正在检测…" Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="OverviewRuntimeLabel" Text="Node.js 与 npm 运行环境" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="NpmDependencyText" x:Uid="DetectingStatus" Text="正在检测…" Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" x:Uid="DependencySettingsButton" Content="管理依赖" Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center" Click="NavigateDependencies_Click" />
                            </Grid>
                        </Border>

                        <TextBlock x:Uid="ServiceStatusHeading" Text="ChatGPT 客户端与 Codex CLI" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左卡片：ChatGPT 桌面客户端 -->
                            <Border Style="{StaticResource PanelStyle}" MinHeight="180">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Uid="DesktopCardTitle" Text="ChatGPT 桌面客户端" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="DesktopCardSubtitle" Text="OpenAI 官方 Windows 桌面应用" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="DesktopStatusBadgeBorder" Background="#E5F6EF" CornerRadius="10" Padding="8,3" VerticalAlignment="Top">
                                            <TextBlock x:Name="DesktopStatusBadgeText" x:Uid="StatusDetectingShort" Text="检测中" Foreground="{StaticResource SignalBrush}" Style="{StaticResource PillTextStyle}" />
                                        </Border>
                                    </Grid>

                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="CurrentVersionLabel" Text="当前版本" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" x:Name="DesktopCurrentVersionText" Text="—" Style="{StaticResource MonoTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" x:Uid="LatestVersionLabel" Text="最新版本" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DesktopLatestVersionText" Text="—" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                            <Border x:Name="DesktopUpdateBadgeBorder" Visibility="Collapsed" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock x:Name="DesktopUpdateBadgeText" Text="已是最新" Style="{StaticResource PillTextStyle}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock x:Name="DesktopPathText" Text="—" Style="{StaticResource MonoCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button x:Uid="CheckUpdateButton" Content="检查更新" Tag="desktop" Click="CheckComponentUpdate_Click" Style="{StaticResource QuietButtonStyle}" />
                                        <Button x:Name="DesktopStartButton" x:Uid="ActionStart" Content="启动" Style="{StaticResource ActionButtonStyle}" Tag="start" Click="DesktopAction_Click" />
                                        <Button x:Name="DesktopStopButton" x:Uid="ActionStop" Content="停止" Style="{StaticResource ActionButtonStyle}" Tag="stop" Click="DesktopAction_Click" />
                                        <Button x:Name="DesktopRestartButton" x:Uid="ActionRestart" Content="重启" Style="{StaticResource ActionButtonStyle}" Tag="restart" Click="DesktopAction_Click" />
                                        <Button x:Name="DesktopInstallButton" x:Uid="DesktopStoreInstallButton" Content="商店安装/升级" Style="{StaticResource ActionButtonStyle}" Tag="install" Click="DesktopAction_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 右卡片：Codex CLI 命令行 -->
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" MinHeight="180">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Codex CLI" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="CodexCardSubtitle" Text="OpenAI 官方命令行工具" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="CodexStatusBadgeBorder" Background="#E5F6EF" CornerRadius="10" Padding="8,3" VerticalAlignment="Top">
                                            <TextBlock x:Name="CodexStatusBadgeText" x:Uid="StatusDetectingShort" Text="检测中" Foreground="{StaticResource SignalBrush}" Style="{StaticResource PillTextStyle}" />
                                        </Border>
                                    </Grid>

                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="CurrentVersionLabel" Text="当前版本" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" x:Name="CodexCurrentVersionText" Text="—" Style="{StaticResource MonoTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" x:Uid="LatestVersionLabel" Text="最新版本" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CodexLatestVersionText" Text="—" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                            <Border x:Name="CodexUpdateBadgeBorder" Visibility="Collapsed" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock x:Name="CodexUpdateBadgeText" Text="已是最新" Style="{StaticResource PillTextStyle}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="AccountStatusLabel" Text="登录状态" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" x:Name="CodexAccountStatusText" Text="—" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock x:Name="CodexPathText" Text="—" Style="{StaticResource MonoCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button x:Name="CodexLoginButton" x:Uid="ActionLogin" Content="登录" Style="{StaticResource ActionButtonStyle}" Tag="login" Click="CodexAction_Click" />
                                        <Button x:Uid="CheckUpdateButton" Content="检查更新" Tag="codex" Click="CheckComponentUpdate_Click" Style="{StaticResource QuietButtonStyle}" />
                                        <Button x:Name="CodexUpgradeButton" x:Uid="ActionUpgrade" Content="升级" Style="{StaticResource ActionButtonStyle}" Tag="upgrade" Click="CodexAction_Click" />
                                        <Button x:Uid="DependencySettingsButton" Content="依赖设置" Style="{StaticResource ActionButtonStyle}" Click="NavigateDependencies_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================ 进程 ============================ -->
                <ScrollViewer x:Name="ProcessesPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,20,28,36">
                    <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">
                        <TextBlock x:Uid="ProcessesTitle" Text="Codex 进程" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Uid="ProcessesDescription" Text="仅展示 ChatGPT 桌面应用与 Codex CLI 相关进程，版本按各可执行文件实际来源单独读取。"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />

                        <Border Style="{StaticResource PanelStyle}" Padding="18,14" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Uid="ProcessQuickActionsTitle" Text="进程快捷操作" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="ProcessQuickActionsDescription" Text="一键清理残留进程，或重新启动 ChatGPT 桌面应用" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Uid="KillCodexProcesses" Content="终止所有 Codex 进程" Style="{StaticResource DangerButtonStyle}"
                                            Tag="kill-codex" Click="KillCodexProcesses_Click" />
                                    <Button x:Uid="RestartDesktopApp" Content="重启 ChatGPT 桌面客户端" Style="{StaticResource QuietButtonStyle}"
                                            Tag="restart-desktop" Click="RestartDesktopApp_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}" Padding="0" Margin="0,16,0,0">
                            <ListView x:Name="ProcessList" ItemsSource="{x:Bind Processes}" SelectionMode="None">
                                <ListView.Header>
                                    <Border Style="{StaticResource TableHeaderBorderStyle}">
                                        <Grid Padding="16,11" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="ProcessPidHeader" Text="PID" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" x:Uid="ProcessRoleHeader" Text="角色 / 进程" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" x:Uid="ProcessVersionHeader" Text="版本" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" x:Uid="ProcessStartedHeader" Text="启动时间" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" x:Uid="ProcessPathHeader" Text="可执行路径" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="16,10" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Pid}" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Role}" Style="{StaticResource BodyTextStyle}" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource MonoCaptionStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding VersionLabel}" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding StartedAtLabel}" Style="{StaticResource MonoCaptionStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding PathLabel}" Style="{StaticResource MonoCaptionStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================= 网络与代理 ========================= -->
                <ScrollViewer x:Name="NetworkPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,20,28,36">
                    <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">
                        <TextBlock x:Uid="NetworkTitle" Text="网络与代理" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Uid="NetworkDescription" Text="配置代理模式，即时测试 ChatGPT 与 Codex CLI 连通性，并查看出口 IP 与风险画像。"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />

                        <!-- 步骤 1：代理模式设置与测试 -->
                        <TextBlock x:Uid="ProxyModeHeading" Text="代理模式与设置" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Uid="EffectiveProxyLabel" Text="当前生效路径" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="EffectiveProxyModeText" Text="正在检测…" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="ConfiguredProxyModeText" Text="—" Style="{StaticResource MonoCaptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock x:Uid="SystemProxyStateLabel" Text="Windows 系统代理" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="SystemProxyStatusText" Text="正在检测…" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="SystemProxyAddressText" Text="—" Style="{StaticResource MonoCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock x:Uid="TunAutoStateLabel" Text="TUN / 自动代理" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="TunStatusText" Text="正在检测…" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="AutoProxyStatusText" Text="—" Style="{StaticResource MonoCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Uid="ProxyModeHint" Text="选择代理工作模式；切换或填入代理地址后可直接测试连通性，确认无误后点击保存生效。" Style="{StaticResource CaptionTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <ComboBox x:Name="NetworkModePicker" Width="260" SelectedValuePath="Tag" SelectionChanged="NetworkModePicker_SelectionChanged">
                                        <ComboBoxItem x:Uid="ProxyModeAuto" Content="自动检测" Tag="auto" />
                                        <ComboBoxItem x:Uid="ProxyModeSystem" Content="使用系统代理" Tag="system" />
                                        <ComboBoxItem x:Uid="ProxyModeTun" Content="使用 TUN 虚拟网卡" Tag="tun" />
                                        <ComboBoxItem x:Uid="ProxyModeCustom" Content="自定义 HTTP 代理" Tag="custom" />
                                    </ComboBox>
                                    <TextBox x:Name="CustomHttpProxyBox" x:Uid="CustomHttpProxyBox" PlaceholderText="http://127.0.0.1:7890" Width="460" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Uid="CheckNetworkButton" Content="立即测试网络连通性" Style="{StaticResource ActionButtonStyle}" Click="CheckNetwork_Click" />
                                    <Button x:Uid="SaveNetworkButton" Content="保存网络设置" Style="{StaticResource QuietButtonStyle}" Click="SaveSettings_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 步骤 2：连通性实时测试结果 -->
                        <TextBlock x:Uid="ConnectivityHeading" Text="网络连通性" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="10">
                                <ItemsControl ItemsSource="{x:Bind NetworkProbes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,12">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource MonoCaptionStyle}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding LatencyLabel}" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="3" Background="{Binding StatusBackground}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" Style="{StaticResource PillTextStyle}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 步骤 3：公网出口 · OpenAI 视角 -->
                        <TextBlock x:Uid="EgressHeading" Text="公网出口 · OpenAI 视角" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="14">
                                <ItemsControl ItemsSource="{x:Bind PublicEgressRoutes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Address}" Style="{StaticResource MonoStrongStyle}" />
                                                    <TextBlock Text="{Binding LocationSummary}" Style="{StaticResource CardTitleStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Border Background="#E5F6EF" CornerRadius="10" Padding="8,3" Visibility="{Binding LineTypeVisibility}">
                                                            <TextBlock Text="{Binding LineTypeLabel}" Foreground="{StaticResource SignalBrush}" Style="{StaticResource PillTextStyle}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding RegionLabel}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="8" MinWidth="250">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Uid="EgressIspLabel" Text="运营商" Style="{StaticResource CaptionTextStyle}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding IspLabel}" Style="{StaticResource MonoTextStyle}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Uid="EgressAsnLabel" Text="ASN" Style="{StaticResource CaptionTextStyle}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding AsNumberLabel}" Style="{StaticResource MonoTextStyle}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Uid="EgressTrustLabel" Text="信任分" Style="{StaticResource CaptionTextStyle}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding TrustLabel}" Style="{StaticResource MonoTextStyle}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Grid ColumnSpacing="12">
