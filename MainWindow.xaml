                                    <TextBlock x:Name="ChatGptProxyStateText" Text="正在检测代理状态…" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="ChatGptProviderText" Text="—" Style="{StaticResource MonoCaptionStyle}" />
