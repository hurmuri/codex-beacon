                                </Grid>
                                <TextBlock x:Uid="NvmMirrorHint" Text="nodejs.org 在部分网络下不可达。镜像可在“设置”中修改；镜像失败时会自动回退到官方源。"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="ModulesHeading" Text="Windows 基础依赖" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource PanelStyle}" Padding="0">
                            <ListView x:Name="InstallationList" ItemsSource="{x:Bind InstallableComponents}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="18,15" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                                    <HyperlinkButton Content="{Binding RepositoryLabel}" NavigateUri="{Binding RepositoryUri}" Padding="0" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock x:Uid="InstalledVersionLabel" Text="当前版本" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding InstalledVersionLabel}" Style="{StaticResource MonoTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <TextBlock x:Uid="LatestVersionLabel" Text="已知最新版本" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding LatestVersionLabel}" Style="{StaticResource MonoTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                                <Button x:Uid="InstallPackageButton" Content="安装" Style="{StaticResource ActionButtonStyle}" Tag="install" Click="PackageAction_Click" IsEnabled="{Binding CanInstall}" />
                                                <Button x:Uid="UpgradePackageButton" Content="升级" Style="{StaticResource ActionButtonStyle}" Tag="upgrade" Click="PackageAction_Click" IsEnabled="{Binding CanUpgrade}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <TextBlock x:Uid="DownloadSourcesHeading" Text="下载源" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource PanelStyle}">
                            <Grid ColumnSpacing="18" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="NodeMirrorFieldLabel" Text="Node.js 下载镜像" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="NodeMirrorPicker" HorizontalAlignment="Stretch" SelectedValuePath="Tag">
                                    <ComboBoxItem x:Uid="NodeSourceOfficial" Content="官方 · https://nodejs.org/dist" Tag="https://nodejs.org/dist" />
                                    <ComboBoxItem x:Uid="NodeSourceTsinghua" Content="清华大学 TUNA · https://mirrors.tuna.tsinghua.edu.cn/nodejs-release" Tag="https://mirrors.tuna.tsinghua.edu.cn/nodejs-release" />
                                    <ComboBoxItem x:Uid="NodeSourceAliyun" Content="阿里云 · https://mirrors.aliyun.com/nodejs-release" Tag="https://mirrors.aliyun.com/nodejs-release" />
                                    <ComboBoxItem x:Uid="NodeSourceTencent" Content="腾讯云 · https://mirrors.cloud.tencent.com/nodejs-release" Tag="https://mirrors.cloud.tencent.com/nodejs-release" />
                                    <ComboBoxItem x:Uid="NodeSourceHuawei" Content="华为云 · https://repo.huaweicloud.com/nodejs" Tag="https://repo.huaweicloud.com/nodejs" />
                                </ComboBox>
                                <TextBlock x:Uid="NpmRegistryFieldLabel" Grid.Row="1" Text="npm Registry（nrm 预设）" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="NpmRegistryPicker" HorizontalAlignment="Stretch" SelectedValuePath="Tag">
                                    <ComboBoxItem x:Uid="NpmSourceOfficial" Content="npm 官方 · https://registry.npmjs.org" Tag="https://registry.npmjs.org" />
                                    <ComboBoxItem x:Uid="NpmSourceYarn" Content="Yarn · https://registry.yarnpkg.com" Tag="https://registry.yarnpkg.com" />
                                    <ComboBoxItem x:Uid="NpmSourceTencent" Content="腾讯云 · https://mirrors.cloud.tencent.com/npm" Tag="https://mirrors.cloud.tencent.com/npm" />
                                    <ComboBoxItem x:Uid="NpmSourceCnpm" Content="CNPM · https://r.cnpmjs.org" Tag="https://r.cnpmjs.org" />
                                    <ComboBoxItem x:Uid="NpmSourceTaobao" Content="淘宝 / npmmirror · https://registry.npmmirror.com" Tag="https://registry.npmmirror.com" />
                                    <ComboBoxItem x:Uid="NpmSourceMirror" Content="npmMirror · https://skimdb.npmjs.com/registry" Tag="https://skimdb.npmjs.com/registry" />
                                    <ComboBoxItem x:Uid="NpmSourceHuawei" Content="华为云 · https://repo.huaweicloud.com/repository/npm" Tag="https://repo.huaweicloud.com/repository/npm" />
                                </ComboBox>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="10">
                                    <TextBlock x:Uid="NpmRegistryHint" Text="安装或升级 Codex CLI、Relay 时通过 --registry 使用；与系统 npm config 是两套配置。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <Button x:Uid="SaveDependenciesButton" Content="保存依赖设置" Click="SaveSettings_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================== Codex Relay ========================== -->
                <ScrollViewer x:Name="RelayPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,20,28,36">
                    <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">
                        <TextBlock Text="Codex Relay" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Uid="RelayDescription" Text="可选的移动端桥接扩展；安装、版本、服务和计划任务均在此页管理。" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />

                        <!-- 服务与版本控制 -->
                        <TextBlock x:Uid="ServiceControlHeading" Text="服务控制" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="RelayCardTitle" Text="Codex Relay 桥接服务" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="RelayCardSubtitle" Text="移动设备与桌面端 Codex 的双向通信扩展 (默认端口 8787)" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#E5F6EF" CornerRadius="10" Padding="10,3" VerticalAlignment="Top">
                                        <TextBlock x:Name="RelayStatusBadgeText" x:Uid="StatusDetectingShort" Text="检测中" Foreground="{StaticResource SignalBrush}" Style="{StaticResource PillTextStyle}" />
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="24" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock x:Uid="CurrentVersionLabel" Text="当前版本" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="RelayCurrentVersionText" Text="—" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" x:Uid="LatestVersionLabel" Text="最新版本" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RelayLatestVersionText" Text="—" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="CheckNewerButton" Content="检查新版本" Tag="relay" Click="CheckComponentUpdate_Click" Style="{StaticResource QuietButtonStyle}" />
                                    <Button x:Name="RelayUpgradeButton" x:Uid="ActionUpgrade" Content="升级" Tag="upgrade" Click="RelayAction_Click" Style="{StaticResource ActionButtonStyle}" />
                                    <Button x:Name="RelayInstallButton" x:Uid="ActionInstall" Content="安装" Tag="install" Click="RelayAction_Click" Style="{StaticResource ActionButtonStyle}" />
                                    <Button x:Name="RelayStartButton" x:Uid="ActionStart" Content="启动" Tag="start" Click="RelayAction_Click" Style="{StaticResource ActionButtonStyle}" />
                                    <Button x:Name="RelayStopButton" x:Uid="ActionStop" Content="停止" Tag="stop" Click="RelayAction_Click" Style="{StaticResource ActionButtonStyle}" />
                                    <Button x:Uid="ActionRestart" Content="重启" Tag="restart" Click="RelayAction_Click" Style="{StaticResource ActionButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 服务设置 -->
                        <TextBlock x:Uid="TaskScheduleHeading" Text="计划任务配置" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="10">
                                <TextBox x:Name="RelayTaskNameBox" x:Uid="RelayTaskNameBox" Header="Codex Relay 计划任务" Width="460" HorizontalAlignment="Left" />
                                <Button x:Uid="SaveRelayButton" Content="保存 Relay 设置" Click="SaveSettings_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- =========================== 设置 =========================== -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,20,28,36">
                    <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">
                        <TextBlock x:Uid="SettingsTitle" Text="设置" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Uid="SettingsDescription" Text="配置刷新频率、显示语言与下载镜像。所有值仅保存在本机，不含任何密钥。"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />

                        <toolkit:SettingsExpander x:Uid="GeneralSettingsExpander" Header="常规设置" Description="刷新频率、显示语言与本机任务映射" IsExpanded="True">
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard x:Uid="LanguageCard" Header="显示语言" Description="跟随 Windows，或在 English / 简体中文之间即时切换" IsClickEnabled="False">
                                    <ComboBox x:Name="LanguagePicker" Style="{StaticResource InputComboBoxStyle}" Width="200" SelectedValuePath="Tag" SelectionChanged="LanguagePicker_SelectionChanged">
                                        <ComboBoxItem x:Uid="LanguageSystem" Content="跟随 Windows" Tag="system" />
                                        <ComboBoxItem Content="English" Tag="en-US" />
                                        <ComboBoxItem x:Uid="LanguageZh" Content="简体中文" Tag="zh-CN" />
                                    </ComboBox>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="RefreshIntervalCard" Header="自动刷新间隔" Description="5–300 秒" IsClickEnabled="False">
                                    <NumberBox x:Name="RefreshSecondsBox" Style="{StaticResource InputNumberBoxStyle}" Width="150" Minimum="5" Maximum="300" SpinButtonPlacementMode="Compact" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="StartupCard" Header="开机自启" Description="登录 Windows 后仅在系统托盘中启动 Codex Beacon" IsClickEnabled="False">
                                    <ToggleSwitch x:Name="StartupToggle" OnContent="" OffContent="" Toggled="StartupToggle_Toggled" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="SaveChangesCard" Header="保存更改" Description="立即生效并存储在本机" IsClickEnabled="False">
                                    <Button x:Uid="SaveButton" Content="保存设置" Style="{StaticResource QuietButtonStyle}" Click="SaveSettings_Click" />
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <!-- 关于 Codex Beacon 与项目开源信息 (诉求 11) -->
                        <TextBlock x:Uid="AboutOpenSourceHeading" Text="关于 Codex Beacon 与项目开源信息" Style="{StaticResource SectionTitleStyle}" />
                        <toolkit:SettingsExpander x:Uid="ProjectInfoExpander" Header="项目信息" Description="Codex Beacon 自身版本与 GitHub 仓库详情" IsExpanded="True">
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard x:Uid="ProjectVersionCard" Header="当前版本" Description="Windows x64 独立原生应用" IsClickEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="ProjectVersionText" Text="—" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="ProjectPackageText" Text="—" Style="{StaticResource PillTextStyle}" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="ProjectRepoCard" Header="GitHub 源码仓库" Description="hurmuri/codex-beacon" IsClickEnabled="False">
                                    <HyperlinkButton Content="https://github.com/hurmuri/codex-beacon" NavigateUri="https://github.com/hurmuri/codex-beacon" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="ProjectLicenseCard" Header="开源许可协议" Description="宽松的自由软件授权" IsClickEnabled="False">
                                    <TextBlock Text="MIT License" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <TextBlock x:Uid="UpdateSectionHeading" Text="关于与更新" Style="{StaticResource SectionTitleStyle}" />
                        <toolkit:SettingsExpander x:Uid="UpdateExpander" Header="应用更新" Description="从官方 GitHub 发布页检测、下载并原地重启到新版本" IsExpanded="True">
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard x:Uid="VersionCard" Header="当前版本" Description="Codex Beacon 自身的构建版本与安装包类型" IsClickEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="AppVersionText" Text="—" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource HairlineBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="AppPackageText" Text="—" Style="{StaticResource PillTextStyle}" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="AutoUpdateCard" Header="自动检查更新" Description="启动后自动查询最新版本，发现新版本时在窗口顶部提示" IsClickEnabled="False">
                                    <ToggleSwitch x:Name="AutoUpdateToggle" OnContent="" OffContent="" Toggled="AutoUpdateToggle_Toggled" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="UpdateActionCard" Header="检查与安装" Description="始终使用官方 GitHub Releases 渠道，不使用任何第三方镜像" IsClickEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button x:Name="CheckUpdateButton" x:Uid="CheckUpdateButton" Content="检查更新" Style="{StaticResource QuietButtonStyle}" Click="CheckUpdate_Click" />
                                        <Button x:Name="DownloadUpdateButton" x:Uid="DownloadUpdateButton" Content="下载并更新" Style="{StaticResource QuietButtonStyle}" Click="DownloadUpdate_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <Border Style="{StaticResource PanelStyle}" Margin="0,12,0,0">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="UpdateDetailHeading" Text="更新状态" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="UpdateStatusText" Text="—" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Top">
                                        <HyperlinkButton x:Name="OpenReleaseButton" x:Uid="OpenReleaseButton" Content="打开发布页" Padding="0" Click="OpenRelease_Click" />
                                        <HyperlinkButton x:Name="SkipVersionButton" x:Uid="SkipVersionButton" Content="跳过此版本" Padding="0" Visibility="Collapsed" Click="SkipVersion_Click" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />
                                <TextBlock x:Name="UpdateProgressText" Text="" Style="{StaticResource MonoCaptionStyle}" Visibility="Collapsed" />
                                <TextBlock x:Name="UpdatePublishedText" Text="" Style="{StaticResource CaptionTextStyle}" Visibility="Collapsed" />
                                <TextBlock x:Name="UpdateNotesHeadingText" x:Uid="UpdateNotesHeading" Text="版本说明"
                                           Style="{StaticResource CardTitleStyle}" Visibility="Collapsed" />
                                <ScrollViewer x:Name="UpdateNotesScroll" MaxHeight="170" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                    <TextBlock x:Name="UpdateNotesText" Style="{StaticResource CaptionTextStyle}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Uid="ReferencesHeading" Text="上游与开源参考" Style="{StaticResource SectionTitleStyle}" />
                        <toolkit:SettingsExpander x:Uid="OpenSourceProjectsExpander" Header="参考项目" Description="组件源码与实现参考" IsExpanded="True">
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard x:Uid="ReferenceOpencodex" Header="OpenCodex" Description="可选 Provider 代理扩展"><HyperlinkButton Content="lidge-jun/opencodex" NavigateUri="https://github.com/lidge-jun/opencodex" /></toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="ReferenceAppManager" Header="Codex App Manager" Description="Codex 桌面版本管理方案参考"><HyperlinkButton Content="Wangnov/Codex-App-Manager" NavigateUri="https://github.com/Wangnov/Codex-App-Manager" /></toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="ReferenceRelay" Header="Codex Relay" Description="可选移动端桥接扩展"><HyperlinkButton Content="gronxb/codex-relay" NavigateUri="https://github.com/gronxb/codex-relay" /></toolkit:SettingsCard>
                                <toolkit:SettingsCard x:Uid="ReferenceIpCoffee" Header="ip.net.coffee" Description="ChatGPT / Codex 出口 IP 与风险检测数据源"><HyperlinkButton Content="ip.net.coffee/gpt" NavigateUri="https://ip.net.coffee/gpt/" /></toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- 状态栏 -->
        <Grid Grid.Row="3" Background="{StaticResource BarBrush}" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" x:Uid="StatusReady" Text="准备就绪"
                       Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <ProgressBar x:Name="OperationProgressBar" Grid.Column="2" Width="150" Height="4" Margin="12,0" Visibility="Collapsed" />
            <Button x:Name="CancelButton" Grid.Column="3" x:Uid="CancelRunning" Content="取消" Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}" Margin="0,0,12,0" Click="CancelRunning_Click" />
            <Button Grid.Column="4" x:Name="OpenLogsButton" Style="{StaticResource QuietButtonStyle}" Margin="0,0,12,0" Click="OpenLogs_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE9D5;" FontSize="13" />
                    <TextBlock x:Uid="OpenLogsLabel" Text="日志" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="RefreshAgeText" Grid.Column="5" x:Uid="StatusNotRefreshed" Text="尚未刷新"
                       Style="{StaticResource MonoCaptionStyle}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
