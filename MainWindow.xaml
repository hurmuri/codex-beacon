                                                <Button Grid.Column="1" x:Uid="RefreshProviderModelsButton" Content="刷新此 Provider" Click="OpenCodexProviderModels_Refresh" Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center" />
