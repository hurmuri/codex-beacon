                                    <TextBlock x:Name="NpmPathText" Text="—" Style="{StaticResource MonoCaptionStyle}" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock x:Name="NpmNoteText" Text="—" Style="{StaticResource CaptionTextStyle}" MaxLines="2" />
                                </StackPanel>
