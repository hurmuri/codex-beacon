                                            </Grid>
                                            <Grid Padding="12,8" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="148" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="ModelVisibilityHeader" Text="在客户端显示" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
